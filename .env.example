# Copy to .env.local and adjust.

# Where the Vite dev server proxies /api and /ws (sos-vietnam-be-v2, Spring Boot).
BACKEND_URL=http://localhost:8080

# Base URL the browser uses for API calls. Leave empty to go through the Vite
# proxy (same origin). Set it only when the API lives on another host.
VITE_API_URL=
