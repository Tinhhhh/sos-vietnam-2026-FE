{
  "name": "sos-vietnam-fe-v2",
  "private": true,
  "version": "0.1.0",
  "description": "SOS Việt Nam 2026 — React frontend (cổng người dân + cổng trực ban)",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "css:extract": "node tools/legacy-css/extract.mjs tools/legacy-css/legacy-css.config.mjs && prettier --write \"src/**/*.css\"",
    "css:extract:officer": "node tools/legacy-css/extract.mjs tools/legacy-css/officer-css.config.mjs && prettier --write \"src/{components/layouts/officer-layout,features/officer-header,features/incident-queue,features/command-map}/**/*.css\""
  },
  "dependencies": {
    "axios": "^1.20.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "prettier": "^3.9.9",
    "vite": "^8.3.4"
  }
}
