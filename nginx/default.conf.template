# Rendered by the nginx image at start-up: ${PORT} and ${BACKEND_URL} come from the environment.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/geo+json image/svg+xml;

    # ---- Backend (same origin for the browser: no CORS, media URLs like /api/... just work)
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Incident media upload limit is 60 MB per request on the backend
        client_max_body_size 60m;
        # A sleeping free-tier backend can take a while to wake up
        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
    }

    location /ws {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $proxy_host;
        proxy_read_timeout 3600s;
    }

    # ---- Static files
    # Vite's hashed bundles never change: cache for a year.
    location ~* "-[A-Za-z0-9_-]{8}\.(js|mjs|css)$" {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Boundary data (several MB): gzip it and let the browser revalidate.
    location ~* \.geojson$ {
        types { }
        default_type application/geo+json;
        add_header Cache-Control "public, no-cache";
        try_files $uri =404;
    }

    # SPA: unknown paths render index.html, which must never be cached.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
